# Copy to .env and fill in real values. docker-compose.yml overrides both
# of these automatically to point at the local `db` service (note the 5433
# host port below — see docker-compose.yml for why it's not the 5432
# default). Only used if you run the app or drizzle-kit outside
# docker-compose.
#
# Two roles locally (see docker/initdb/01-app-role.sql, ADR-0009) *and*
# in production (ADR-0011): DATABASE_URL uses the restricted kontrola_app
# role — the app's runtime queries always go through this one, so RLS
# (ADR-0002) is actually exercised. DATABASE_ADMIN_URL uses the bootstrap
# superuser (locally) / the Neon default owner role (in production) and
# is only for drizzle-kit (generate/migrate/push/studio), which needs to
# CREATE TABLE.
#
# ADR-0011: Neon's own default role has BYPASSRLS — a database-owner
# grant, unrelated to SUPERUSER — so it silently ignores every RLS policy
# regardless of FORCE ROW LEVEL SECURITY. A single-role Neon setup, which
# earlier revisions of this file assumed was safe, is NOT: it means zero
# database-level tenant isolation, with app code as the only backstop.
# The restricted role has to be created in Neon too, same as locally.
DATABASE_URL=postgres://kontrola_app:kontrola_app@localhost:5433/kontrola
DATABASE_ADMIN_URL=postgres://kontrola:kontrola@localhost:5433/kontrola

# Auth.js -- generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# Web Push (VAPID keypair — generate with `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ADR-0003: server-managed key for Transaction description/note field
# encryption (src/lib/crypto.ts). Must be exactly 32 bytes once base64-decoded.
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=replace-with-a-long-random-string

# #16 Forgot Password, ADR-0012: Resend sends the reset-link email.
# RESEND_FROM_EMAIL defaults to the sandbox sender (onboarding@resend.dev,
# which only delivers to the account owner's own verified address) when
# unset — set both once a real domain is verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
