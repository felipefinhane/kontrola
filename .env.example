# Copy to .env and fill in real values. docker-compose.yml overrides
# DATABASE_URL automatically to point at the local `db` service — the value
# below is only used if you run the app outside docker-compose (note the
# 5433 host port — see docker-compose.yml for why it's not the 5432 default).
DATABASE_URL=postgres://kontrola:kontrola@localhost:5433/kontrola

# Auth.js
AUTH_SECRET=replace-with-a-long-random-string

# Web Push (VAPID keypair — generate with `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ADR-0003: server-managed key for Transaction description/obs field encryption
FIELD_ENCRYPTION_KEY=replace-with-a-long-random-string
