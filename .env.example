# Copy to .env and fill in real values. docker-compose.yml overrides both
# of these automatically to point at the local `db` service (note the 5433
# host port below — see docker-compose.yml for why it's not the 5432
# default). Only used if you run the app or drizzle-kit outside
# docker-compose.
#
# Two roles locally (see docker/initdb/01-app-role.sql, ADR-0009):
# DATABASE_URL uses the restricted kontrola_app role — the app's runtime
# queries always go through this one, so RLS (ADR-0002) is actually
# exercised. DATABASE_ADMIN_URL uses the bootstrap superuser and is only
# for drizzle-kit (generate/migrate/push/studio), which needs to CREATE
# TABLE. In production (Neon) there's just one role — DATABASE_ADMIN_URL
# is unset there and drizzle.config.ts falls back to DATABASE_URL, since
# FORCE ROW LEVEL SECURITY alone is enough (Neon's role isn't a true
# superuser, just the table owner).
DATABASE_URL=postgres://kontrola_app:kontrola_app@localhost:5433/kontrola
DATABASE_ADMIN_URL=postgres://kontrola:kontrola@localhost:5433/kontrola

# Auth.js -- generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# Web Push (VAPID keypair — generate with `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ADR-0003: server-managed key for Transaction description/note field
# encryption (src/lib/crypto.ts). Must be exactly 32 bytes once base64-decoded.
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=replace-with-a-long-random-string
